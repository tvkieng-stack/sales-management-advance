<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.salesmanagement.controller.BackupController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="SAO LƯU / KHÔI PHỤC DATABASE" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="8" style="-fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 15;">
        <Label text="Sao lưu (Backup)" style="-fx-font-weight: bold;"/>
        <Label text="Chọn thư mục để lưu file backup:"/>
        <HBox spacing="8">
            <TextField fx:id="backupFolderField" prefWidth="350" editable="false"
                       promptText="Chưa chọn thư mục..."/>
            <Button text="Chọn thư mục..." onAction="#handleChooseBackupFolder"/>
        </HBox>
        <Button text="Tạo bản sao lưu ngay" onAction="#handleBackup"/>
    </VBox>

    <VBox spacing="8" style="-fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 15;">
        <Label text="Khôi phục (Restore)" style="-fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
        <Label text="⚠ Khôi phục sẽ THAY THẾ toàn bộ dữ liệu hiện tại bằng file backup đã chọn."
               style="-fx-text-fill: #c0392b;" wrapText="true"/>
        <HBox spacing="8">
            <TextField fx:id="restoreFileField" prefWidth="350" editable="false"
                       promptText="Chưa chọn file backup..."/>
            <Button text="Chọn file backup..." onAction="#handleChooseRestoreFile"/>
        </HBox>
        <Button text="Khôi phục dữ liệu" onAction="#handleRestore" style="-fx-text-fill: #c0392b;"/>
    </VBox>

    <Label fx:id="messageLabel" wrapText="true"/>
</VBox>