<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.salesmanagement.controller.InventoryController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="8">
            <Label text="NHẬP HÀNG" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Nhà cung cấp:"/>
                <ComboBox fx:id="supplierCombo" prefWidth="200"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="15">
            <VBox spacing="8" prefWidth="380">
                <Label text="Chọn sản phẩm" style="-fx-font-weight: bold;"/>
                <ListView fx:id="productListView" prefHeight="320"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="SL:"/>
                    <TextField fx:id="quantityField" text="1" prefWidth="50"/>
                    <Label text="Giá nhập:"/>
                    <TextField fx:id="unitCostField" prefWidth="80"/>
                </HBox>
                <Button text="Thêm vào phiếu nhập" onAction="#handleAddToCart"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Phiếu nhập hiện tại" style="-fx-font-weight: bold;"/>
                <TableView fx:id="cartTable" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="cartNameColumn" text="Sản phẩm" prefWidth="150"/>
                        <TableColumn fx:id="cartQtyColumn" text="SL" prefWidth="50"/>
                        <TableColumn fx:id="cartCostColumn" text="Giá nhập" prefWidth="90"/>
                        <TableColumn fx:id="cartSubtotalColumn" text="Thành tiền" prefWidth="100"/>
                    </columns>
                </TableView>
                <Button text="Xóa dòng đã chọn" onAction="#handleRemoveFromCart"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="TỔNG: 0"/>
                <Button text="Xác nhận nhập hàng" onAction="#handleConfirmPurchase" style="-fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>