<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.salesmanagement.controller.PosController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="8">
            <HBox spacing="8">
                <TextField fx:id="searchField" promptText="Tìm sản phẩm theo tên hoặc barcode..." prefWidth="350"/>
                <Button text="Tìm" onAction="#handleSearch"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Khách hàng:"/>
                <ComboBox fx:id="customerCombo" prefWidth="220" promptText="Khách vãng lai"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="15">
            <VBox spacing="8" prefWidth="380">
                <Label text="Danh sách sản phẩm" style="-fx-font-weight: bold;"/>
                <ListView fx:id="productListView" prefHeight="380"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Số lượng:"/>
                    <TextField fx:id="quantityField" text="1" prefWidth="60"/>
                    <Button text="Thêm vào giỏ" onAction="#handleAddToCart"/>
                </HBox>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Giỏ hàng" style="-fx-font-weight: bold;"/>
                <TableView fx:id="cartTable" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="cartNameColumn" text="Sản phẩm" prefWidth="150"/>
                        <TableColumn fx:id="cartQtyColumn" text="SL" prefWidth="50"/>
                        <TableColumn fx:id="cartPriceColumn" text="Đơn giá" prefWidth="90"/>
                        <TableColumn fx:id="cartSubtotalColumn" text="Thành tiền" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button text="Xóa dòng đã chọn" onAction="#handleRemoveFromCart"/>
                    <Button text="Xóa giỏ hàng" onAction="#handleClearCart"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Khuyến mãi:"/>
                <ComboBox fx:id="promotionCombo" prefWidth="200" promptText="Không áp dụng"/>
                <Label text="Giảm giá hóa đơn:"/>
                <TextField fx:id="invoiceDiscountField" text="0" prefWidth="80"/>
                <Label text="Thanh toán:"/>
                <ComboBox fx:id="paymentMethodCombo" prefWidth="120"/>
                <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="TỔNG: 0"/>
                <Button text="Thanh toán" onAction="#handleCheckout" style="-fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>