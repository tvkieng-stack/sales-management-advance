<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.salesmanagement.controller.CategoryController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="10">
            <Label text="QUẢN LÝ DANH MỤC" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="nameField" promptText="Tên danh mục" prefWidth="200"/>
                <TextField fx:id="descriptionField" promptText="Mô tả" prefWidth="250"/>
                <Button text="Thêm mới" onAction="#handleAdd"/>
                <Button text="Cập nhật" onAction="#handleUpdate"/>
                <Button text="Vô hiệu hóa" onAction="#handleDeactivate"/>
                <Button text="Làm mới" onAction="#handleRefresh"/>
            </HBox>
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="categoryTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nameColumn" text="Tên danh mục" prefWidth="200"/>
                <TableColumn fx:id="descriptionColumn" text="Mô tả" prefWidth="250"/>
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>